{
  "description": "",
  "type": "project",
  "keywords": [
    "ILIAS",
    "Plugin"
  ],
  "license": "GPL-3.0-only",
  "require": {
    "php": "^8.2 || ^8.3",
    "ramsey/uuid": "^4"
  },
  "autoload": {
    "psr-4": {
      "ILIAS\\Plugin\\OnlyOffice\\": "src/"
    },
    "classmap": [
      "classes/"
    ]
  },
  "config": {
    "classmap-authoritative": true,
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
    ,
    "captainhook/captainhook": "^5.24",
    "friendsofphp/php-cs-fixer": "^3.66"
  }
}
